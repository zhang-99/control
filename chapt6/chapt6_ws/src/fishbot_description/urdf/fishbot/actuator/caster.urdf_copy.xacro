<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="caster_xacro" params="caster_name xyz">
    <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertia_copy.xacro" />

        <link name="${caster_name}_caster_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
               
                        <sphere radius="0.016"/>
                 
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
                
            </visual>

            <collision>
                
   
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
               
                        <sphere radius="0.016"/>
                 
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
                
            </collision>

            <xacro:sphere_inertia m="0.5" r="0.016"></xacro:sphere_inertia>
            
        </link>


        <joint name="${caster_name}_caster_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${caster_name}_caster_link"/>
            <origin xyz="${xyz}"/>
            <axis xyz="0.0 0.0 0.0"/>
            
            
        </joint>
    </xacro:macro>
    
</robot>
